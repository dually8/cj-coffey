{
  "name": "cj-new-astro-blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.22.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    }
  },
  "scripts": {
    "clean": "rimraf ./dist ./.astro",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview:nobuild": "astro preview --host",
    "preview": "astro build && astro preview --host",
    "astro": "astro",
    "astro:check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit:deps": "bun audit --json --audit-level=high",
    "check": "bun run format:check && bun run astro:check && bun run audit:deps && bun run test:e2e",
    "precommit": "bun run clean && bun run format && bun run astro:check && bun run test:e2e && bun run build",
    "generate-images": "tsx ./scripts/generate-apple-icons.ts ./public/img/avatar.png ./public/img/"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@picocss/pico": "^2.1.1",
    "astro": "^7.4.11",
    "dayjs": "^1.11.23",
    "markdown-it": "^15.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sanitize-html": "^2.18.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "1.1.2",
    "rimraf": "^6.1.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  }
}
