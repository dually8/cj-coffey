{
  "name": "cj-new-astro-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "clean": "rimraf ./dist ./.astro",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview:nobuild": "astro preview --host",
    "preview": "astro build && astro preview --host",
    "astro": "astro",
    "astro:check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "format": "npx prettier . --write",
    "precommit": "npm run clean && npm run format && npm run astro:check && npm run test:e2e && npm run build",
    "generate-images": "tsx ./scripts/generate-apple-icons.ts ./public/img/avatar.png ./public/img/"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@picocss/pico": "^2.0.6",
    "astro": "^7.3.1",
    "dayjs": "^1.11.23",
    "markdown-it": "^15.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sanitize-html": "^2.17.7",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/sanitize-html": "^2.16.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13"
  }
}
