{
  "name": "cj-new-astro-blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "rimraf ./dist ./.astro",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview:nobuild": "astro preview --host",
    "preview": "astro build && astro preview --host",
    "astro": "astro",
    "astro:check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "precommit": "bun run clean && bun run format && bun run astro:check && bun run test:e2e && bun run build",
    "generate-images": "tsx ./scripts/generate-apple-icons.ts ./public/img/avatar.png ./public/img/"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@picocss/pico": "^2.1.1",
    "astro": "^7.3.8",
    "dayjs": "^1.11.23",
    "markdown-it": "^15.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sanitize-html": "^2.18.1",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  }
}
